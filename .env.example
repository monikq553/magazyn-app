DATABASE_URL=postgresql://user:password@host:5432/database
SECRET_KEY=replace-with-a-long-random-value
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_API_KEY=replace-with-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
FIREBASE_APP_ID=replace-with-app-id
FIREBASE_MEASUREMENT_ID=replace-with-measurement-id
ADMIN_EMAILS=admin@example.com
BACKUP_ENCRYPTION_KEY=generate-with-python-cryptography-fernet
ALLOW_BACKUP_RESTORE=false
DB_POOL_SIZE=5
RATELIMIT_STORAGE_URI=memory://

ALLOWED_ORIGINS=https://pmagazyn.pl,https://app.pmagazyn.pl
